---
import { SOCIALS } from "@/constants";
import { SITE } from "@/config";
import { getLangFromUrl } from "@/i18n/utils";
import LinkButton from "./LinkButton.astro";

const lang = getLangFromUrl(Astro.url);

const linkTitle = (social: (typeof SOCIALS)[number]) => {
  if (lang !== "fr") return social.linkTitle;
  return social.name === "Mail"
    ? `Envoyer un e-mail à ${SITE.title}`
    : `${SITE.title} sur ${social.name}`;
};
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-2 hover:rotate-6 sm:p-1"
        title={linkTitle(social)}
      >
        <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
        <span class="sr-only">{linkTitle(social)}</span>
      </LinkButton>
    ))
  }
</div>
