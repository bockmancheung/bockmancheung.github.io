---
// Quiddle: a tiny daily puzzle built on real cluster-algebra quiver mutations.
// Kept English-only regardless of page locale (see src/pages/fr/index.astro).
// Each day deterministically picks one of three quiver templates (Easy /
// Medium / Hard, see TEMPLATES in the script below) and a target reachable
// from its start seed, so the puzzle rotates in both shape and difficulty.
---

<section id="quiddle" class="mt-8 border-t border-border pt-8">
  <h2 class="mb-1 text-lg font-semibold">Quiddle</h2>
  <p class="mb-2 max-w-prose text-sm text-foreground/70">
    Each node holds a number and has directed arrows to and from its
    neighbors (some days, arrows come doubled). Click a node to
    <em>mutate</em> it:
  </p>
  <ol class="mb-4 max-w-prose list-decimal space-y-1 pl-5 text-sm text-foreground/70">
    <li>every arrow touching that node reverses direction;</li>
    <li>
      for each arrow that used to point in → node and node → out, a new
      arrow is drawn straight from in to out — unless one's already there
      pointing the other way, in which case the two cancel;
    </li>
    <li>
      the node's number becomes (product of its new in-neighbors' numbers
      + product of its new out-neighbors' numbers) ÷ its old number.
    </li>
  </ol>
  <p class="mb-2 max-w-prose text-sm text-foreground/70">
    That's the real mutation rule from cluster algebra theory, and a real
    theorem (the Laurent phenomenon, plus positivity) guarantees step 3
    always lands on a positive whole number — no matter what you click.
    Match today's target quiver in as few moves as possible.
  </p>
  <p id="qd-note" class="mb-4 hidden max-w-prose text-sm text-foreground/70"></p>

  <div class="flex flex-wrap items-start gap-8">
    <div>
      <div id="qd-board" class="relative mx-auto h-[220px] w-[220px]">
        <svg
          id="qd-arrows-main"
          viewBox="0 0 220 220"
          class="pointer-events-none absolute inset-0 h-full w-full stroke-foreground/60 text-foreground/60"
        >
          <defs>
            <marker
              id="qd-arrowhead-main"
              markerWidth="8"
              markerHeight="8"
              refX="6"
              refY="3"
              orient="auto"
            >
              <path d="M0,0 L6,3 L0,6 Z" fill="currentColor"></path>
            </marker>
          </defs>
          <g id="qd-arrows-main-g"></g>
        </svg>
        <div id="qd-nodes-main" class="absolute inset-0"></div>
      </div>
      <p id="qd-board-desc" class="sr-only" aria-live="polite"></p>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm">
        <span>Difficulty: <strong id="qd-difficulty">-</strong></span>
        <span>Moves: <strong id="qd-moves">0</strong></span>
        <span>Par: <strong id="qd-par">-</strong></span>
        <button
          type="button"
          id="qd-reset"
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
        >
          Reset
        </button>
      </div>
    </div>

    <div class="min-w-[140px]">
      <p class="mb-2 text-sm font-semibold">Today's target</p>
      <div class="relative mx-auto h-[120px] w-[120px]">
        <svg
          id="qd-arrows-target"
          viewBox="0 0 120 120"
          class="pointer-events-none absolute inset-0 h-full w-full stroke-foreground/60 text-foreground/60"
        >
          <defs>
            <marker
              id="qd-arrowhead-target"
              markerWidth="6"
              markerHeight="6"
              refX="5"
              refY="2.5"
              orient="auto"
            >
              <path d="M0,0 L5,2.5 L0,5 Z" fill="currentColor"></path>
            </marker>
          </defs>
          <g id="qd-arrows-target-g"></g>
        </svg>
        <div id="qd-nodes-target" class="absolute inset-0"></div>
      </div>
      <p id="qd-target-desc" class="sr-only"></p>
    </div>
  </div>

  <p id="qd-daily-note" class="mt-4 hidden text-sm text-foreground/70"></p>

  <div
    id="qd-win"
    class="mt-4 hidden rounded border border-border bg-muted/50 p-3 text-sm"
    aria-live="polite"
  >
    <p id="qd-win-text" class="mb-2 font-medium"></p>
    <button
      type="button"
      id="qd-share"
      class="underline decoration-dashed underline-offset-4 hover:text-accent"
    >
      Copy result
    </button>
    <span id="qd-share-status" class="ml-2 text-foreground/60"></span>
  </div>
</section>

<script is:inline data-astro-rerun>
  function initQuiddle() {
    var root = document.getElementById("quiddle");
    if (!root) return;

    var nodesMainEl = root.querySelector("#qd-nodes-main");
    var nodesTargetEl = root.querySelector("#qd-nodes-target");
    var arrowsMainG = root.querySelector("#qd-arrows-main-g");
    var arrowsTargetG = root.querySelector("#qd-arrows-target-g");
    var difficultyEl = root.querySelector("#qd-difficulty");
    var movesEl = root.querySelector("#qd-moves");
    var parEl = root.querySelector("#qd-par");
    var resetBtn = root.querySelector("#qd-reset");
    var noteEl = root.querySelector("#qd-note");
    var dailyNoteEl = root.querySelector("#qd-daily-note");
    var winEl = root.querySelector("#qd-win");
    var winTextEl = root.querySelector("#qd-win-text");
    var shareBtn = root.querySelector("#qd-share");
    var shareStatusEl = root.querySelector("#qd-share-status");
    var boardDescEl = root.querySelector("#qd-board-desc");
    var targetDescEl = root.querySelector("#qd-target-desc");

    if (
      !nodesMainEl ||
      !nodesTargetEl ||
      !arrowsMainG ||
      !arrowsTargetG ||
      !difficultyEl ||
      !movesEl ||
      !parEl ||
      !resetBtn ||
      !noteEl ||
      !dailyNoteEl ||
      !winEl ||
      !winTextEl ||
      !shareBtn ||
      !shareStatusEl
    ) {
      return;
    }

    var LABELS = ["A", "B", "C", "D"];

    function zeros(n) {
      var rows = [];
      for (var i = 0; i < n; i++) rows.push(new Array(n).fill(0));
      return rows;
    }

    // Three daily templates spanning different quiver shapes and difficulty
    // bands. Each is a genuine cluster-algebra quiver; "par" for all of them
    // is a real shortest-path distance computed by BFS, never hardcoded.
    var b3Path = zeros(3);
    b3Path[0][1] = 1;
    b3Path[1][0] = -1;
    b3Path[1][2] = 1;
    b3Path[2][1] = -1;

    var b4Path = zeros(4);
    b4Path[0][1] = 1;
    b4Path[1][0] = -1;
    b4Path[1][2] = 1;
    b4Path[2][1] = -1;
    b4Path[2][3] = 1;
    b4Path[3][2] = -1;

    // The Markov quiver: a doubled 3-cycle. It's mutation-invariant (every
    // mutation gives back the same doubled-cycle shape), and mutating it
    // from (1,1,1) generates exactly the Markov numbers 1, 2, 5, 13, 29, ...
    var bMarkov = zeros(3);
    bMarkov[0][1] = 2;
    bMarkov[1][0] = -2;
    bMarkov[1][2] = 2;
    bMarkov[2][1] = -2;
    bMarkov[2][0] = 2;
    bMarkov[0][2] = -2;

    var TEMPLATES = [
      {
        id: "easy",
        label: "Easy",
        n: 3,
        startB: b3Path,
        startX: [1, 1, 1],
        positionsMain: [
          [110, 38],
          [42, 178],
          [178, 178],
        ],
        radiusMain: 25,
        positionsTarget: [
          [60, 20],
          [22, 96],
          [98, 96],
        ],
        radiusTarget: 13,
        bfsCap: 500,
        maxDepth: Infinity,
        band: [2, 4],
        note: "",
      },
      {
        id: "medium",
        label: "Medium",
        n: 4,
        startB: b4Path,
        startX: [1, 1, 1, 1],
        positionsMain: [
          [60, 55],
          [160, 55],
          [160, 165],
          [60, 165],
        ],
        radiusMain: 22,
        positionsTarget: [
          [32, 30],
          [88, 30],
          [88, 90],
          [32, 90],
        ],
        radiusTarget: 11,
        bfsCap: 3000,
        maxDepth: Infinity,
        band: [4, 7],
        note: "A 4-node board today — a bit more room to explore.",
      },
      {
        id: "hard",
        label: "Hard",
        n: 3,
        startB: bMarkov,
        startX: [1, 1, 1],
        positionsMain: [
          [110, 38],
          [42, 178],
          [178, 178],
        ],
        radiusMain: 25,
        positionsTarget: [
          [60, 20],
          [22, 96],
          [98, 96],
        ],
        radiusTarget: 13,
        bfsCap: 500,
        maxDepth: 4,
        band: [2, 4],
        note:
          "Today's board is the Markov quiver — every arrow is doubled, and the numbers you'll see are exactly the famous Markov numbers (1, 2, 5, 13, 29, ...).",
      },
    ];

    function stateKey(s) {
      return (
        s.b.map(function (row) { return row.join(","); }).join(";") +
        "|" +
        s.x.join(",")
      );
    }

    // Standard Fomin-Zelevinsky quiver/seed mutation at vertex k.
    function mutate(state, k) {
      var n = state.n,
        b = state.b,
        x = state.x;
      var pos = 1,
        neg = 1;
      for (var i = 0; i < n; i++) {
        if (i === k) continue;
        var bik = b[i][k];
        if (bik > 0) pos *= Math.pow(x[i], bik);
        else if (bik < 0) neg *= Math.pow(x[i], -bik);
      }
      var newX = x.slice();
      newX[k] = Math.round((pos + neg) / x[k]);

      var newB = b.map(function (row) { return row.slice(); });
      for (var i2 = 0; i2 < n; i2++) {
        for (var j2 = 0; j2 < n; j2++) {
          if (i2 === k || j2 === k) newB[i2][j2] = -b[i2][j2];
        }
      }
      for (var i3 = 0; i3 < n; i3++) {
        for (var j3 = 0; j3 < n; j3++) {
          if (i3 === k || j3 === k || i3 === j3) continue;
          var bik2 = b[i3][k];
          var bkj2 = b[k][j3];
          newB[i3][j3] =
            b[i3][j3] + (Math.abs(bik2) * bkj2 + bik2 * Math.abs(bkj2)) / 2;
        }
      }
      return { n: n, b: newB, x: newX };
    }

    function bfsFrom(start, cap, maxDepth) {
      var dist = new Map();
      dist.set(stateKey(start), { dist: 0, state: start, path: [] });
      var queue = [start];
      var head = 0;
      while (head < queue.length && dist.size < cap) {
        var cur = queue[head++];
        var entry = dist.get(stateKey(cur));
        if (entry.dist >= maxDepth) continue;
        for (var k = 0; k < cur.n; k++) {
          var next = mutate(cur, k);
          var nk = stateKey(next);
          if (!dist.has(nk)) {
            dist.set(nk, {
              dist: entry.dist + 1,
              state: next,
              path: entry.path.concat([k]),
            });
            queue.push(next);
          }
        }
      }
      return dist;
    }

    function seededRng(str) {
      var h = 1779033703 ^ str.length;
      for (var i = 0; i < str.length; i++) {
        h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
        h = (h << 13) | (h >>> 19);
      }
      return function () {
        h = Math.imul(h ^ (h >>> 16), 2246822519);
        h = Math.imul(h ^ (h >>> 13), 3266489917);
        h ^= h >>> 16;
        return (h >>> 0) / 4294967296;
      };
    }

    function pickFromBand(dist, lo, hi, rng) {
      function collect(filterFn) {
        var out = [];
        dist.forEach(function (v) {
          if (filterFn(v)) out.push(v);
        });
        out.sort(function (a, b) {
          var ka = stateKey(a.state),
            kb = stateKey(b.state);
          return ka < kb ? -1 : ka > kb ? 1 : 0;
        });
        return out;
      }
      var inBand = collect(function (v) {
        return v.dist >= lo && v.dist <= hi;
      });
      var pool = inBand.length
        ? inBand
        : collect(function (v) {
            return v.dist > 0;
          });
      var idx = Math.floor(rng() * pool.length);
      return pool[idx];
    }

    function describeState(state) {
      var parts = [];
      for (var i = 0; i < state.n; i++) {
        parts.push("Node " + LABELS[i] + " = " + state.x[i]);
      }
      var edges = [];
      for (var a = 0; a < state.n; a++) {
        for (var b = a + 1; b < state.n; b++) {
          var val = state.b[a][b];
          if (val === 0) continue;
          var suffix = Math.abs(val) > 1 ? " (×" + Math.abs(val) + ")" : "";
          if (val > 0) edges.push(LABELS[a] + " → " + LABELS[b] + suffix);
          else edges.push(LABELS[b] + " → " + LABELS[a] + suffix);
        }
      }
      return (
        parts.join(", ") +
        ". Arrows: " +
        (edges.length ? edges.join(", ") : "none") +
        "."
      );
    }

    function buildNodes(containerEl, positions, radius, n, interactive, onClick) {
      containerEl.innerHTML = "";
      var els = [];
      var _make = function (i) {
        var el = document.createElement(interactive ? "button" : "div");
        el.style.position = "absolute";
        el.style.left = positions[i][0] + "px";
        el.style.top = positions[i][1] + "px";
        el.style.width = radius * 2 + "px";
        el.style.height = radius * 2 + "px";
        el.style.transform = "translate(-50%, -50%)";
        el.className = interactive
          ? "flex items-center justify-center rounded-full border border-border bg-background font-semibold shadow-sm transition hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
          : "flex items-center justify-center rounded-full border border-border bg-background/60 text-xs";
        if (interactive) {
          el.type = "button";
          el.addEventListener("click", function () {
            onClick(i);
          });
        } else {
          el.setAttribute("aria-hidden", "true");
        }
        containerEl.appendChild(el);
        els.push(el);
      };
      for (var i = 0; i < n; i++) _make(i);
      return els;
    }

    function updateNodes(els, state, interactive) {
      for (var i = 0; i < state.n; i++) {
        els[i].textContent = String(state.x[i]);
        if (interactive) {
          els[i].setAttribute(
            "aria-label",
            "Mutate node " + LABELS[i] + ", current value " + state.x[i]
          );
          els[i].title = "Node " + LABELS[i] + ": " + state.x[i];
        }
      }
    }

    function renderArrows(gEl, positions, radius, state, markerId) {
      var html = "";
      var SPACING = 3.5;
      for (var i = 0; i < state.n; i++) {
        for (var j = i + 1; j < state.n; j++) {
          var val = state.b[i][j];
          if (val === 0) continue;
          var from = val > 0 ? i : j;
          var to = val > 0 ? j : i;
          var weight = Math.abs(val);
          var x1 = positions[from][0],
            y1 = positions[from][1];
          var x2 = positions[to][0],
            y2 = positions[to][1];
          var dx = x2 - x1,
            dy = y2 - y1;
          var len = Math.sqrt(dx * dx + dy * dy) || 1;
          var ux = dx / len,
            uy = dy / len;
          var px = -uy,
            py = ux;
          var gap = radius + 4;
          var sx = x1 + ux * gap,
            sy = y1 + uy * gap;
          var ex = x2 - ux * gap,
            ey = y2 - uy * gap;
          for (var w = 0; w < weight; w++) {
            var offset = (w - (weight - 1) / 2) * SPACING;
            html +=
              '<line x1="' +
              (sx + px * offset) +
              '" y1="' +
              (sy + py * offset) +
              '" x2="' +
              (ex + px * offset) +
              '" y2="' +
              (ey + py * offset) +
              '" stroke="currentColor" stroke-width="1.75" marker-end="url(#' +
              markerId +
              ')" />';
          }
        }
      }
      gEl.innerHTML = html;
    }

    var todayStr = new Date().toISOString().slice(0, 10);
    var templateIdx = Math.floor(
      seededRng(todayStr + ":difficulty")() * TEMPLATES.length
    );
    var template = TEMPLATES[templateIdx];
    var START = { n: template.n, b: template.startB, x: template.startX };

    var dist = bfsFrom(START, template.bfsCap, template.maxDepth);
    var targetEntry = pickFromBand(
      dist,
      template.band[0],
      template.band[1],
      seededRng(todayStr + ":target")
    );
    var target = targetEntry.state;
    var par = targetEntry.dist;

    var current = START;
    var moves = 0;

    difficultyEl.textContent = template.label;
    parEl.textContent = String(par);
    if (template.note) {
      noteEl.textContent = template.note;
      noteEl.classList.remove("hidden");
    }

    var mainNodeEls = buildNodes(
      nodesMainEl,
      template.positionsMain,
      template.radiusMain,
      template.n,
      true,
      onNodeClick
    );
    var targetNodeEls = buildNodes(
      nodesTargetEl,
      template.positionsTarget,
      template.radiusTarget,
      template.n,
      false,
      null
    );

    function render() {
      updateNodes(mainNodeEls, current, true);
      renderArrows(
        arrowsMainG,
        template.positionsMain,
        template.radiusMain,
        current,
        "qd-arrowhead-main"
      );
      movesEl.textContent = String(moves);
      if (boardDescEl)
        boardDescEl.textContent = "Current — " + describeState(current);
    }

    function renderTarget() {
      updateNodes(targetNodeEls, target, false);
      renderArrows(
        arrowsTargetG,
        template.positionsTarget,
        template.radiusTarget,
        target,
        "qd-arrowhead-target"
      );
      if (targetDescEl)
        targetDescEl.textContent = "Target — " + describeState(target);
    }

    function showWin() {
      var diff = moves - par;
      var tierLabel =
        diff === 0
          ? "🏆 Optimal!"
          : diff === 1
            ? "🥈 One over par."
            : diff === 2
              ? "🥉 Two over par."
              : "✅ Solved.";
      winTextEl.textContent =
        tierLabel +
        " " +
        moves +
        " move" +
        (moves === 1 ? "" : "s") +
        " (par " +
        par +
        ").";
      winEl.classList.remove("hidden");

      var stored = null;
      try {
        stored = JSON.parse(localStorage.getItem("quiddleResult") || "null");
      } catch (e) {
        stored = null;
      }
      if (!stored || stored.date !== todayStr) {
        try {
          localStorage.setItem(
            "quiddleResult",
            JSON.stringify({
              date: todayStr,
              moves: moves,
              par: par,
              difficulty: template.label,
            })
          );
        } catch (e) {
          /* ignore storage failures */
        }
        dailyNoteEl.textContent =
          "Recorded as today's official result. Keep clicking to explore, or hit Reset to try again for fun.";
        dailyNoteEl.classList.remove("hidden");
      }
    }

    function checkWin() {
      if (stateKey(current) === stateKey(target)) showWin();
    }

    function onNodeClick(k) {
      current = mutate(current, k);
      moves++;
      render();
      checkWin();
    }

    resetBtn.addEventListener("click", function () {
      current = START;
      moves = 0;
      winEl.classList.add("hidden");
      render();
    });

    shareBtn.addEventListener("click", function () {
      var diff = Math.max(0, moves - par);
      var bar = "🟢".repeat(par) + (diff > 0 ? "🟠".repeat(diff) : "");
      var text =
        "Quiddle (" +
        template.label +
        ") — " +
        todayStr +
        "\nSolved in " +
        moves +
        " (par " +
        par +
        ")\n" +
        bar;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard
          .writeText(text)
          .then(function () {
            shareStatusEl.textContent = "Copied!";
          })
          .catch(function () {
            shareStatusEl.textContent = text;
          });
      } else {
        shareStatusEl.textContent = text;
      }
    });

    (function showPersisted() {
      var stored = null;
      try {
        stored = JSON.parse(localStorage.getItem("quiddleResult") || "null");
      } catch (e) {
        stored = null;
      }
      if (stored && stored.date === todayStr) {
        dailyNoteEl.textContent =
          "Today's official result: " +
          stored.moves +
          " move" +
          (stored.moves === 1 ? "" : "s") +
          " (par " +
          stored.par +
          "). Board below is free practice.";
        dailyNoteEl.classList.remove("hidden");
      }
    })();

    render();
    renderTarget();
  }

  initQuiddle();
</script>
