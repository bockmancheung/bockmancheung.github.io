---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import BookTable from "@/components/BookTable.astro";
import { toReadBooks, readingNowBooks, readBooks } from "@/data/books";
import { SITE } from "@/config";
---

<Layout title={`Books | ${SITE.title}`} description="What I'm reading next, now, and what I've read since 2026.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 pb-4">
    <h1 class="text-2xl font-semibold sm:text-3xl">Books</h1>
    <p class="mt-2 mb-6 italic">
      What I'm reading next, now, and what I've read since 2026.
    </p>

    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <BookTable
        heading="To Read"
        books={toReadBooks}
        emptyMessage="Nothing queued up yet — check back soon."
      />
      <BookTable
        heading="Reading Now"
        books={readingNowBooks}
        emptyMessage="Nothing in progress right now — check back soon."
      />
      <BookTable
        heading="Read since 2026"
        books={readBooks}
        emptyMessage="Nothing logged yet — check back soon."
        showFinishedColumn
      />
    </div>
  </main>
  <Footer />
</Layout>
