---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import BookTable from "@/components/BookTable.astro";
import { toReadBooks, readingNowBooks, readBooks } from "@/data/books";
import { useTranslations } from "@/i18n/utils";
import { SITE } from "@/config";

const t = useTranslations("fr");
---

<Layout title={`${t("books.title")} | ${SITE.title}`} description={t("books.desc")}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 pb-4">
    <h1 class="text-2xl font-semibold sm:text-3xl">{t("books.title")}</h1>
    <p class="mt-2 mb-6 italic">
      {t("books.desc")}
    </p>

    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <BookTable
        heading={t("books.toRead")}
        books={toReadBooks}
        emptyMessage={t("books.empty.toRead")}
      />
      <BookTable
        heading={t("books.readingNow")}
        books={readingNowBooks}
        emptyMessage={t("books.empty.readingNow")}
      />
      <BookTable
        heading={t("books.readSince")}
        books={readBooks}
        emptyMessage={t("books.empty.read")}
        showFinishedColumn
      />
    </div>
  </main>
  <Footer />
</Layout>
